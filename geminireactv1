// --- COMPONENT ---
const NeonatalFinder = () => {
  const [searchTerm, setSearchTerm] = useState('');
  const [result, setResult] = useState(null);

  // Helper function to identify network
  const findNetwork = (hospitalString) => {
    const hospitals = hospitalString.split('/').map(h => h.trim());
    const primaryHospital = hospitals[0];
    
    for (const [network, unitList] of Object.entries(HOSPITAL_NETWORKS)) {
      if (unitList.some(unit => primaryHospital.includes(unit))) {
        return network;
      }
    }
    return "Outside London / Other";
  };

  // Handle Search
  const handleSearch = (e) => {
    const input = e.target.value.toUpperCase();
    setSearchTerm(input);
    
    const outwardCode = input.split(' ')[0]; // "SW19 5XX" -> "SW19"

    if (outwardCode.length >= 2 && POSTCODE_DATA[outwardCode]) {
      const hospital = POSTCODE_DATA[outwardCode];
      setResult({
        found: true,
        hospital: hospital,
        network: findNetwork(hospital)
      });
    } else {
      setResult(outwardCode.length >= 3 ? { found: false } : null);
    }
  };

  // --- RENDER HELPERS ---
  const NetworkCard = ({ color, title, hospitals, specialist }) => {
    const colorClasses = {
      blue: "border-blue-500 text-blue-600 bg-blue-50",
      teal: "border-teal-500 text-teal-600 bg-teal-50",
      emerald: "border-emerald-500 text-emerald-600 bg-emerald-50",
      orange: "border-orange-500 text-orange-600 bg-orange-50",
      purple: "border-purple-500 text-purple-600 bg-purple-50"
    };

    return (
      <div className={`bg-white p-5 rounded-lg shadow border-l-4 ${colorClasses[color].split(' ')[0]} hover:-translate-y-1 hover:shadow-lg transition-all duration-200`}>
        <h3 className="font-bold text-lg text-slate-700 mb-2">{title}</h3>
        <p className="text-sm text-slate-600 leading-relaxed">
          {hospitals}
          <br />
          <span className={`text-xs font-bold px-2 py-0.5 rounded mt-2 inline-block ${colorClasses[color].split(' ').slice(1).join(' ')}`}>
            Specialist: {specialist}
          </span>
        </p>
      </div>
    );
  };

  return (
    <div className="bg-slate-50 min-h-screen text-slate-800 font-sans pb-20">
      {/* Header */}
      <header className="bg-indigo-600 text-white py-8 shadow-lg">
        <div className="container mx-auto px-4 max-w-3xl text-center">
          <h1 className="text-4xl font-bold mb-2">HO.ME</h1>
          <p className="text-indigo-100 text-lg">HOspital near ME: Neonatal Unit Finder</p>
          <p className="text-xs text-indigo-300 mt-2 uppercase tracking-wide">Based on Sept 2025 Guidelines</p>
        </div>
      </header>

      {/* Main Search Section */}
      <main className="container mx-auto px-4 max-w-2xl -mt-6 relative z-10">
        <div className="bg-white rounded-xl shadow-xl p-6 border border-slate-100">
          <label className="block text-sm font-semibold text-slate-500 mb-2 uppercase tracking-wider">
            Enter Patient Postcode
          </label>
          <div className="relative">
            <input 
              type="text" 
              value={searchTerm}
              onChange={handleSearch}
              className="w-full p-4 text-lg border-2 border-slate-200 rounded-lg focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/20 outline-none transition-all placeholder:text-slate-300"
              placeholder="e.g. SW19, E1, N12..."
            />
            <div className="absolute right-4 top-4 text-slate-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
          
          {/* Results Area */}
          {result && result.found && (
            <div className="mt-6 bg-indigo-50 rounded-lg p-6 border border-indigo-100 animate-in fade-in slide-in-from-top-2 duration-300">
              <h3 className="text-sm font-bold text-indigo-400 uppercase mb-1">Designated Neonatal Unit</h3>
              <div className="text-3xl font-bold text-indigo-900 mb-2">{result.hospital}</div>
              <div className="flex items-center gap-2">
                <span className="text-sm font-semibold text-slate-500">Network:</span>
                <span className="px-3 py-1 bg-white rounded-full text-xs font-bold text-indigo-600 shadow-sm border border-indigo-100">
                  {result.network}
                </span>
              </div>
            </div>
          )}

          {result && !result.found && (
            <div className="mt-4 text-center p-4 text-slate-400 italic animate-in fade-in duration-200">
              No specific match found. Please check the postcode or refer to the network map below.
            </div>
          )}
        </div>

        {/* Networks Reference Grid */}
        <div className="mt-12">
          <h2 className="text-2xl font-bold text-slate-800 mb-6 text-center">London Neonatal Networks</h2>
          <div className="grid gap-4 md:grid-cols-2">
            <NetworkCard 
              color="blue"
              title="North Central London"
              hospitals="Royal Free, North Middlesex, Barnet, Whittington"
              specialist="UCH, GOSH"
            />
            <NetworkCard 
              color="teal"
              title="North West London"
              hospitals="West Middlesex, Hillingdon, Northwick Park, St. Mary's, Chelsea & Westminster"
              specialist="Queen Charlotte's"
            />
            <NetworkCard 
              color="emerald"
              title="North East London"
              hospitals="Queen's Romford, Newham, Whipps Cross, Homerton"
              specialist="Royal London"
            />
            <NetworkCard 
              color="orange"
              title="South West London"
              hospitals="Epsom, Kingston, Croydon, St. Helier's"
              specialist="St. George's"
            />
            <NetworkCard 
              color="purple"
              title="South East London"
              hospitals="Lewisham, QEW, PRUH, King's College"
              specialist="St. Thomas' (GSTT), Evelina"
            />
          </div>
        </div>
      </main>
    </div>
  );
};

